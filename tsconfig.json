{
    "compilerOptions": {
        "target": "ES2016",
        "module": "CommonJS",
        "lib": [
            "es2016",
        ],
        "sourceMap": false,
        "moduleResolution": "node",
        "preserveWatchOutput": true,
        "rootDir": "./",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true
    },
    "include": [
        "bin/**/*.ts",
    ],
}
